#!/bin/sh
# commit-msg hook — 校验提交信息格式
# 要求: <type>: <中文标题>
# 类型: feat|fix|refactor|perf|docs|style|test|build|chore
#
# 绕过: git commit --no-verify

PATTERN="^(feat|fix|refactor|perf|docs|style|test|build|chore): "

MSG_FILE="$1"
TITLE=$(head -n 1 "$MSG_FILE")

# 跳过 merge 提交（git 自动生成的信息）
echo "$TITLE" | grep -qE "^Merge " && exit 0

if ! echo "$TITLE" | grep -qE "$PATTERN"; then
    echo ""
    echo "  ✖ 提交信息格式错误"
    echo "    标题行需要: <type>: <中文标题>"
    echo ""
    echo "    类型标签:"
    echo "      feat    新功能"
    echo "      fix     修复 bug"
    echo "      refactor  重构"
    echo "      perf    性能优化"
    echo "      docs    文档"
    echo "      style   格式/注释清理"
    echo "      test    测试"
    echo "      build   构建系统"
    echo "      chore   杂项"
    echo ""
    echo "    示例:"
    echo "      feat: 添加 -j N 并行编译支持"
    echo "      fix: 修复路径规范化缓冲区溢出"
    echo "      docs: 更新项目手册"
    echo ""
    echo "    绕过: git commit --no-verify"
    echo ""
    exit 1
fi

exit 0
