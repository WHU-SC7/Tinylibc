#!/bin/sh
# commit-msg hook
# 1) 校验提交信息格式: <type>: <中文标题>
# 2) 将提交信息写入 CLAUDE_COMMITS.md（含详细 body）
#
# 绕过: git commit --no-verify

set -e

MSG_FILE="$1"
FULL_MSG=$(cat "$MSG_FILE")
SUBJECT=$(echo "$FULL_MSG" | head -1)

# ── 格式校验 ──────────────────────────────────────────
PATTERN="^(feat|fix|refactor|perf|docs|style|test|build|chore): "

# 跳过 merge 提交（git 自动生成的信息）
echo "$SUBJECT" | grep -qE "^Merge " && exit 0

if ! echo "$SUBJECT" | grep -qE "$PATTERN"; then
    echo ""
    echo "  ✖ 提交信息格式错误"
    echo "    标题行需要: <type>: <中文标题>"
    echo ""
    echo "    类型标签:"
    echo "      feat    新功能"
    echo "      fix     修复 bug"
    echo "      refactor  重构"
    echo "      perf    性能优化"
    echo "      docs    文档"
    echo "      style   格式/注释清理"
    echo "      test    测试"
    echo "      build   构建系统"
    echo "      chore   杂项"
    echo ""
    echo "    示例:"
    echo "      feat: 添加 -j N 并行编译支持"
    echo "      fix: 修复路径规范化缓冲区溢出"
    echo "      docs: 更新项目手册"
    echo ""
    echo "    绕过: git commit --no-verify"
    echo ""
    exit 1
fi

# ── 写入 CLAUDE_COMMITS.md ───────────────────────────

COMMITS_FILE="CLAUDE_COMMITS.md"
[ -f "$COMMITS_FILE" ] || exit 0

# 跳过对 CLAUDE_COMMITS.md / CLAUDE.md 本身的提交
echo "$SUBJECT" | grep -qiE "CLAUDE_COMMITS|claude_commits|CLAUDE\.md" && exit 0

# 解析提交信息
DATE_ONLY=$(date '+%Y-%m-%d')
TIME_ONLY=$(date '+%H:%M')
TYPE=$(echo "$SUBJECT" | sed -n 's/^\([a-z]*\):.*/\1/p')
TITLE=$(echo "$SUBJECT" | sed 's/^[a-z]*: //')

# 提取 body：跳过 subject 行和紧跟的空行，去掉 Co-Authored-By 尾注
BODY=$(echo "$FULL_MSG" | tail -n +2 | sed '/./,$!d' | grep -v '^Co-Authored-By:')

if [ -n "$BODY" ]; then
    ENTRY="### $TIME_ONLY — $TYPE: $TITLE

$BODY"
else
    ENTRY="### $TIME_ONLY — $TYPE: $TITLE"
fi

# ── 用 head/tail 插入条目 ────────────────────────────
LINE_NUM=$(grep -n "^## $DATE_ONLY$" "$COMMITS_FILE" | head -1 | cut -d: -f1)

if [ -z "$LINE_NUM" ]; then
    printf "\n## %s\n\n%s\n\n" "$DATE_ONLY" "$ENTRY" >> "$COMMITS_FILE"
else
    head -n "$LINE_NUM" "$COMMITS_FILE" > "${COMMITS_FILE}.tmp"
    printf "\n%s\n\n---\n" "$ENTRY" >> "${COMMITS_FILE}.tmp"
    tail -n +$((LINE_NUM + 1)) "$COMMITS_FILE" >> "${COMMITS_FILE}.tmp"
    mv "${COMMITS_FILE}.tmp" "$COMMITS_FILE"
fi

git add "$COMMITS_FILE"

exit 0
