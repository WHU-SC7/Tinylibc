#!/bin/sh
# post-commit hook — 自动记录提交到 CLAUDE_COMMITS.md，附加到本次提交
#
# 流程：
#   1. 读取刚提交信息（hash/日期/标题）
#   2. 用 awk 插入条目到 CLAUDE_COMMITS.md（当天最前，时间倒序）
#   3. git add + git commit --amend --no-edit 附加到本次提交
#   4. 递归调用（amend 触发）：修正 CLAUDE_COMMITS.md 中的 hash
#      （amend 会改变 hash），仅 git add，不再 amend
#
# 最终效果：git log 中一次工作一条提交，hash 正确。
# 注意：hash 修正会作为暂存变更保留到下一次提交（修正量极小）。

COMMITS_FILE="CLAUDE_COMMITS.md"
[ -f "$COMMITS_FILE" ] || exit 0

# ── 递归守卫 ───────────────────────────────────────────────
# amend 会再次触发 post-commit，用文件锁区分原始调用和递归
REPO_TAG=$(basename "$(git rev-parse --show-toplevel 2>/dev/null)" 2>/dev/null || echo "unknown")
GUARD="/tmp/.claude-${REPO_TAG}-amend"

if [ -f "$GUARD" ]; then
    # ── 递归调用（amend 后）：修正 hash ──
    OLD_HASH=$(cat "$GUARD")
    NEW_HASH=$(git log -1 --format="%h")

    if [ "$OLD_HASH" != "$NEW_HASH" ]; then
        sed -i "s/\`$OLD_HASH\`/\`$NEW_HASH\`/" "$COMMITS_FILE"
        git add "$COMMITS_FILE"
        echo "  ✓ 已修正 hash: $OLD_HASH → $NEW_HASH"
    fi

    rm -f "$GUARD"
    exit 0
fi

# ── 原始调用：收集提交信息 ────────────────────────────────

HASH=$(git log -1 --format="%h")
DATE_ONLY=$(git log -1 --format="%ai" | awk '{print $1}')
TIME_ONLY=$(git log -1 --format="%ai" | awk '{print $2}' | cut -c1-5)
SUBJECT=$(git log -1 --format="%s")

# 跳过对 CLAUDE_COMMITS.md 本身的提交
echo "$SUBJECT" | grep -qiE "CLAUDE_COMMITS|claude_commits" && exit 0

# 防止重复条目（安全网）
if grep -q "^\`$HASH\`" "$COMMITS_FILE" 2>/dev/null; then
    exit 0
fi

TYPE=$(echo "$SUBJECT" | sed -n 's/^\([a-z]*\):.*/\1/p')
if [ -z "$TYPE" ]; then
    TYPE="chore"
    TITLE="$SUBJECT"
else
    TITLE=$(echo "$SUBJECT" | sed 's/^[a-z]*: //')
fi
ENTRY="### \`$HASH\` $TIME_ONLY — $TYPE: $TITLE"

# ── 用 awk 插入条目（时间倒序）────────────────────────────

TMP=$(mktemp)
trap 'rm -f "$TMP"' EXIT

awk \
  -v today="$DATE_ONLY" \
  -v entry="$ENTRY" \
'
BEGIN   { found=0; printed=0 }

/^## [0-9]{4}-[0-9]{2}-[0-9]{2}$/ {
    if (found || printed) { print; next }

    if ($0 == "## " today) {
        found = 1
        print $0
        print ""
        print entry
        print ""
        print "---"
        while (getline > 0 && $0 ~ /^[[:space:]]*$/) {}
        print
        next
    }

    printed = 1
    print "## " today
    print ""
    print entry
    print ""
    print ""
    print $0
    next
}

{ print }

END {
    if (!found && !printed) {
        print "## " today
        print ""
        print entry
        print ""
    }
}
' "$COMMITS_FILE" > "$TMP" && cp "$TMP" "$COMMITS_FILE"

# ── 暂存并 amend ──────────────────────────────────────────

git add "$COMMITS_FILE"

if git diff --cached --quiet; then
    exit 0
fi

echo "$HASH" > "$GUARD"

if ! git commit --amend --no-edit; then
    rm -f "$GUARD"
    echo "  ⚠ post-commit amend 失败"
    exit 1
fi
